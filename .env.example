# Copy to .env next to docker-compose.yml and fill in.
# .env is gitignored. Never commit it.

# Required. Every API call must present this token.
#   openssl rand -hex 32
LOX_AUTH_TOKEN=

TZ=Etc/UTC

# Match the user that owns your media and runs qBittorrent, so hardlinks work
# and the torrent client can read what lox writes.
PUID=1000
PGID=1000

# MUSIC_DIR and LINKS_DIR must be on the SAME filesystem. Hardlinks cannot
# cross filesystems; if they can't be made, lox either errors or falls back to
# a real copy depending on linking.fallback_to_copy.
MUSIC_DIR=./data/music
LINKS_DIR=./data/links
TORRENTS_DIR=./data/torrents
TMP_DIR=./data/tmp
