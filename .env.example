# Copy to .env next to docker-compose.yml. Gitignored — never commit it.

# Required. Every request to the UI must present this.
#   openssl rand -hex 32
LOX_AUTH_TOKEN=

TZ=Etc/UTC

# Match the user that owns your media and runs qBittorrent, so hardlinks work
# and the torrent client can read what lox writes.
PUID=1000
PGID=1000

# CONFIG/lox holds settings.toml, the database, .torrent output and spectrals.
CONFIG=/path/to/your/appdata

# NAS/data is mounted as /data. Downloads and the seeding directory both live
# under it, which is what makes hardlinking possible.
NAS=/path/to/your/nas
